.seed-button {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    flex-shrink: 0;
    flex-grow: 0;
    width: 100%;
    height: auto;
    min-height: 52px;
    margin: 0 0 6px 0;
    padding: 6px 14px;
    background-color: rgba(192, 179, 236, 0.85);
    border-width: 0;
    border-radius: 8px;
    cursor: initial;
    font-size: 24px;
}

.option-name {
    margin: 0;
    padding: 0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(30, 20, 60);
    white-space: nowrap;
}

.time-button {
    margin: 0;
    padding: 0;
    font-size: 18px;
    -unity-text-align: middle-left;
    color: rgb(30, 20, 60);
    white-space: nowrap;
    opacity: 0.8;
}
.option-unavailable {
    opacity: 0.4;
}
.seed-button:hover {
    background-color: rgba(214, 203, 248, 0.95);
}

.seed-button:active {
    background-color: rgba(160, 146, 214, 0.95);
}