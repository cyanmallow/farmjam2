<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="InventoryVisualElement" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 20%; height: auto; flex-shrink: 0; font-size: 18px; flex-wrap: wrap; flex-direction: column;">
            <ui:VisualElement name="DateAndTimeLabel" style="flex-grow: 0; flex-direction: row; height: auto; width: 100%;">
                <ui:Label text="DayLabel" name="DayLabel" style="font-size: 18px; width: 30%; margin-top: 4px; margin-right: 8px; margin-bottom: 4px; margin-left: 2px;" />
                <ui:Label text="TimeLabel" name="TimeLabel" style="font-size: 18px; width: 50%; margin-top: 4px; margin-right: 8px; margin-bottom: 4px; margin-left: 2px;" />
            </ui:VisualElement>
            <ui:VisualElement name="hunger-bar-container" style="flex-grow: 0; background-size: cover; width: 100%; height: auto;">
                <ui:Label text="Hunger" name="hunger-label" style="font-size: 18px; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                <ui:VisualElement name="hunger-bar-fill" style="flex-grow: 1; background-color: rgb(65, 222, 105); height: 2px; width: 100%;" />
            </ui:VisualElement>
            <ui:VisualElement name="fatigue-bar-container" style="flex-grow: 0; background-size: cover; width: 100%; height: auto;">
                <ui:Label text="Fatigue" name="fatigue-label" style="font-size: 18px; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                <ui:VisualElement name="fatigue-bar-fill" style="flex-grow: 1; background-color: rgb(65, 222, 105); height: 2px; width: 100%;" />
            </ui:VisualElement>
            <ui:VisualElement name="pain-bar-container" style="flex-grow: 0; background-size: cover; width: 100%; height: auto;">
                <ui:Label text="Pain" name="pain-label" style="font-size: 18px; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                <ui:VisualElement name="pain-bar-fill" style="flex-grow: 1; background-color: rgb(65, 222, 105); height: 2px; width: 100%;" />
            </ui:VisualElement>
            <ui:VisualElement name="sanity-bar-container" style="flex-grow: 0; background-size: cover; width: 100%; height: auto;">
                <ui:Label text="Sanity" name="sanity-label" enable-rich-text="true" style="font-size: 18px; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                <ui:VisualElement name="sanity-bar-fill" style="flex-grow: 1; background-color: rgb(65, 222, 105); height: 2px; width: 100%;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 81%; height: 100%; flex-shrink: 0; align-self: flex-end;">
            <ui:ScrollView style="width: 100%; height: 100%; align-self: flex-end; flex-shrink: 0; align-items: auto; -unity-text-align: upper-left; flex-direction: column; flex-grow: 0;">
                <ui:TabView style="flex-grow: 1;">
                    <ui:Tab label="Tab">
                        <ui:TextField label="Text Field" placeholder-text="filler text" />
                    </ui:Tab>
                    <ui:Tab label="Tab" style="flex-grow: 0;">
                        <ui:Slider label="Slider" value="42" high-value="100" />
                    </ui:Tab>
                    <ui:Tab label="Tab" style="flex-grow: 0;">
                        <ui:DropdownField label="Dropdown" />
                    </ui:Tab>
                </ui:TabView>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
