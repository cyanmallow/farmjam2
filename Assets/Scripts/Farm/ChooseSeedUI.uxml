    <ui:VisualElement name="SeedSelectionPanel" style="flex-grow: 0; width: 30%; height: 60%; -unity-text-align: middle-center; white-space: nowrap; align-self: center; justify-content: flex-start; align-items: center; align-content: center; position: absolute; top: auto; left: auto; background-color: rgb(45, 0, 134); right: 5%; opacity: 0.82; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 12px;">
