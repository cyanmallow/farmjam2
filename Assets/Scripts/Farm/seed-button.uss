.seed-button {
    width: 100%;
    height: 30px;
    font-size: 12px;
    padding: 10px 10px;
    margin: 4px;
    -unity-font-style: normal;
    justify-content: center;
    align-self: auto;
    align-content: flex-start;
    padding-right: 10px;
    padding-left: 10px;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 0;
    padding-bottom: 18px;
    flex-shrink: 0;
}
